{
  "openapi": "3.1.0",
  "info": {
    "title": "MandateGate Gateway API",
    "description": "MCP gateway between AI agents and PayPal (Sandbox only).",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health Check",
        "description": "Verify service health and sandbox connectivity status.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/mandates/draft": {
      "post": {
        "tags": [
          "Mandates"
        ],
        "summary": "Generate Mandate Proposal from Prompt",
        "description": "Transforms a natural language task description into an unsigned structured proposal or requests missing parameters. Does not sign or activate anything.",
        "operationId": "create_mandate_draft_mandates_draft_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MandateDraftRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/mandates": {
      "post": {
        "tags": [
          "Mandates"
        ],
        "summary": "Register & Sign Mandate",
        "description": "Confirms, cryptographically signs, and persists an authorized spending mandate.",
        "operationId": "create_mandate_mandates_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MandateDraft"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mandate"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/mandates/{mandate_id}": {
      "get": {
        "tags": [
          "Mandates"
        ],
        "summary": "Retrieve Mandate",
        "description": "Fetches an existing mandate policy by identifier.",
        "operationId": "get_mandate_mandates__mandate_id__get",
        "parameters": [
          {
            "name": "mandate_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Mandate Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mandate"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/mandates/{mandate_id}/revoke": {
      "post": {
        "tags": [
          "Mandates"
        ],
        "summary": "Revoke Mandate (Kill Switch)",
        "description": "Instantly revokes a mandate; takes effect immediately on next transaction.",
        "operationId": "revoke_mandate_mandates__mandate_id__revoke_post",
        "parameters": [
          {
            "name": "mandate_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Mandate Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Revoke Mandate Mandates  Mandate Id  Revoke Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/decisions": {
      "get": {
        "tags": [
          "Audit"
        ],
        "summary": "List Decisions (Paginated)",
        "description": "Returns decisions in reverse chronological order (newest first).",
        "operationId": "list_decisions_decisions_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "mandate_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Mandate Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Decision"
                  },
                  "title": "Response List Decisions Decisions Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/decisions/stream": {
      "get": {
        "tags": [
          "Audit"
        ],
        "summary": "Decision Live Feed (SSE)",
        "description": "Server-Sent Events streaming real-time payment decisions as they occur.",
        "operationId": "stream_decisions_decisions_stream_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/pending": {
      "get": {
        "tags": [
          "Approvals"
        ],
        "summary": "List Pending Approvals",
        "description": "Fetches escalated transactions awaiting human review.",
        "operationId": "list_pending_pending_get",
        "parameters": [
          {
            "name": "mandate_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Mandate Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "title": "Response List Pending Pending Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/pending/{pending_id}/approve": {
      "post": {
        "tags": [
          "Approvals"
        ],
        "summary": "Approve Escalated Payment",
        "description": "Human sign-off: re-verifies mandate before idempotent provider execution.",
        "operationId": "approve_pending_pending__pending_id__approve_post",
        "parameters": [
          {
            "name": "pending_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Pending Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Approve Pending Pending  Pending Id  Approve Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/pending/{pending_id}/deny": {
      "post": {
        "tags": [
          "Approvals"
        ],
        "summary": "Deny Escalated Payment",
        "description": "Human operator rejects an escalated payment request.",
        "operationId": "deny_pending_pending__pending_id__deny_post",
        "parameters": [
          {
            "name": "pending_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Pending Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Deny Pending Pending  Pending Id  Deny Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/audit": {
      "get": {
        "tags": [
          "Audit"
        ],
        "summary": "Audit Log & Chain Integrity",
        "description": "Retrieves all decision audit rows and verifies cryptographic chain integrity.",
        "operationId": "get_audit_log_audit_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditResponse"
                }
              }
            }
          }
        }
      }
    },
    "/payments": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Process Payment Request",
        "description": "Evaluates an agent payment request through rules, safety judge, and provider.",
        "operationId": "process_payment_payments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Decision"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuditResponse": {
        "properties": {
          "chain_valid": {
            "type": "boolean",
            "title": "Chain Valid"
          },
          "broken_decision_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Broken Decision Id"
          },
          "total_records": {
            "type": "integer",
            "title": "Total Records"
          },
          "rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Rows"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "chain_valid",
          "total_records",
          "rows"
        ],
        "title": "AuditResponse",
        "description": "Cryptographic audit chain verification status and log rows."
      },
      "Decision": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Id",
            "description": "Unique decision event identifier."
          },
          "verdict": {
            "$ref": "#/components/schemas/Verdict",
            "description": "Outcome of the evaluation: approve, block, or escalate."
          },
          "rule_results": {
            "items": {
              "$ref": "#/components/schemas/RuleResult"
            },
            "type": "array",
            "title": "Rule Results",
            "description": "Individual rule execution results that determined this verdict."
          },
          "judge_reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Judge Reason",
            "description": "Optional explanation provided by the LLM safety judge."
          },
          "explanation": {
            "type": "string",
            "maxLength": 2000,
            "title": "Explanation",
            "description": "Plain-English explanation built from rule results and judge reason.",
            "default": ""
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "UTC timestamp when the decision was rendered."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "verdict",
          "created_at"
        ],
        "title": "Decision",
        "description": "Audit record and enforcement verdict produced for a PaymentRequest."
      },
      "DraftResult": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "'ready' when complete, 'needs_info' if incomplete."
          },
          "draft": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MandateProposal"
              },
              {
                "type": "null"
              }
            ],
            "description": "Unsigned proposal if status is 'ready'."
          },
          "fields_needed": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Fields Needed",
            "description": "Missing essential fields requiring user clarification."
          },
          "clarification_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clarification Prompt",
            "description": "Helpful question prompting user for missing details."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "DraftResult",
        "description": "Result of processing a natural language mandate draft request."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Mandate": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Id",
            "description": "Unique identifier for the mandate."
          },
          "purpose": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Purpose",
            "description": "The user's original task text and authorization scope."
          },
          "max_amount_minor": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Max Amount Minor",
            "description": "Total lifetime spending cap allowed by this mandate in minor units (cents)."
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "description": "3-letter ISO 4217 currency code (e.g. 'USD')."
          },
          "allowed_payees": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Allowed Payees",
            "description": "List of permitted payee identifiers (emails or merchant IDs)."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At",
            "description": "UTC expiration timestamp of the mandate."
          },
          "approval_threshold_minor": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Threshold Minor",
            "description": "Optional minor threshold requiring human review."
          },
          "max_payments_per_window": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Payments Per Window",
            "description": "Optional maximum count of payments allowed in a velocity window."
          },
          "window_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Window Seconds",
            "description": "Optional duration of velocity window in seconds."
          },
          "signature": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Signature",
            "description": "Cryptographic signature guaranteeing mandate integrity."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "purpose",
          "max_amount_minor",
          "currency",
          "allowed_payees",
          "expires_at",
          "signature"
        ],
        "title": "Mandate",
        "description": "Authorized spending policy defining constraints for agent payments.\nAmounts must be integer minor units (e.g. USD cents)."
      },
      "MandateDraft": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Id"
          },
          "purpose": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Purpose"
          },
          "max_amount_minor": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Max Amount Minor"
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency"
          },
          "allowed_payees": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Allowed Payees"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "approval_threshold_minor": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Threshold Minor"
          },
          "max_payments_per_window": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Payments Per Window"
          },
          "window_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Window Seconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "purpose",
          "max_amount_minor",
          "currency",
          "allowed_payees",
          "expires_at"
        ],
        "title": "MandateDraft",
        "description": "Draft policy submitted by UI/user to be confirmed and signed."
      },
      "MandateDraftRequest": {
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Prompt",
            "description": "User's task description."
          },
          "candidate_payees": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidate Payees",
            "description": "Optional explicit candidate payees or shops."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "MandateDraftRequest",
        "description": "Natural language task prompt submitted to generate an unsigned proposal."
      },
      "MandateProposal": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique generated draft ID."
          },
          "purpose": {
            "type": "string",
            "title": "Purpose",
            "description": "Normalized task description."
          },
          "max_amount_minor": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Max Amount Minor",
            "description": "Spending cap in integer cents."
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "description": "ISO 4217 currency."
          },
          "allowed_payees": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Allowed Payees",
            "description": "Explicit named payees."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At",
            "description": "UTC expiration timestamp."
          },
          "approval_threshold_minor": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Threshold Minor",
            "description": "Optional threshold for human approval."
          },
          "max_payments_per_window": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Payments Per Window"
          },
          "window_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Window Seconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "purpose",
          "max_amount_minor",
          "currency",
          "allowed_payees",
          "expires_at"
        ],
        "title": "MandateProposal",
        "description": "Unsigned structured mandate proposal returned to user for review."
      },
      "PaymentRequest": {
        "properties": {
          "mandate_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Mandate Id",
            "description": "Identifier of the mandate authorizing this transaction."
          },
          "payee": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Payee",
            "description": "Target recipient identifier (email or merchant ID)."
          },
          "amount_minor": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Amount Minor",
            "description": "Transaction amount in integer minor units (e.g. cents)."
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
