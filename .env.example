# MandateGate Environment Configuration (SANDBOX ONLY)

# PayPal Developer Sandbox Credentials
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Mandate Security
MANDATE_SIGNING_KEY=your_mandate_hmac_or_ed25519_signing_key_here

# LLM Judge Configuration (Advisory safety net: block or escalate only)
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
JUDGE_MODEL=gemini-2.5-flash

# Storage & Persistence
DB_PATH=mandategate.sqlite3

# Server & CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
