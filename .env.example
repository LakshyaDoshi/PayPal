# ==============================================================================
# MandateGate Environment Configuration (SANDBOX ONLY)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Mandate Security (REQUIRED)
# ------------------------------------------------------------------------------
# Secret key for HMAC-SHA256 mandate cryptographic signing and verification.
# Must be at least 32 characters long. The server will refuse to start if unset
# or shorter than 32 characters.
# Generate with: openssl rand -hex 32
MANDATE_SIGNING_KEY=your_secret_signing_key_at_least_32_chars_long

# ------------------------------------------------------------------------------
# 2. PayPal Developer Sandbox Credentials (OPTIONAL)
# ------------------------------------------------------------------------------
# When PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET are provided, the gateway uses
# PayPalProvider targeting the sandbox API. If omitted, FakeProvider is used.
# Live PayPal endpoints or credentials must NEVER be configured or called.
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ------------------------------------------------------------------------------
# 3. Advisory AI Safety Judge & LLM (OPTIONAL)
# ------------------------------------------------------------------------------
# LLM_PROVIDER can be 'gemini' (default) or 'fake' (for testing/mocking).
# If LLM_PROVIDER is 'gemini', LLM_API_KEY is required for the judge and drafter.
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
JUDGE_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. Storage & Persistence
# ------------------------------------------------------------------------------
# Path to SQLite database file. Defaults to ':memory:' in tests,
# or 'mandategate.sqlite3' locally. On Render free tier, if the database is
# empty on startup, the startup hook automatically runs scripts/seed.py.
DB_PATH=mandategate.sqlite3

# ------------------------------------------------------------------------------
# 5. Server & CORS Configuration
# ------------------------------------------------------------------------------
# CORS_ORIGINS controls allowed origins for the React front end.
# Supports JSON array (e.g. ["http://localhost:3000","https://app.onrender.com"])
# or comma-separated strings (e.g. http://localhost:3000,https://app.onrender.com).
# Defaults to ["*"] if unset or empty.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Port to bind uvicorn server (Render supplies $PORT automatically)
PORT=8000
